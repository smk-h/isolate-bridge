{
  "//": "Worker 配置文件示例。部署时放在 HGFS 共享根目录下 config/worker.json，worker 启动时只需 --hgfs-root 指向同一目录，其余参数自动从这里读取。优先级：命令行参数 > 环境变量 > 本文件 > 内置默认值。",
  "hgfs_root": "/mnt/hgfs/vm_share",
  "executor": "ssh2",
  "ssh": {
    "host": "192.168.1.100",
    "port": 22,
    "username": "root",
    "private_key_path": "/home/user/.ssh/id_ed25519"
  },
  "audit_log_dir": "/mnt/hgfs/vm_share/logs",
  "policy_file": "/mnt/hgfs/vm_share/policy/policy.json",
  "polling": {
    "initial_interval_ms": 500,
    "max_interval_ms": 3000
  },
  "heartbeat_interval_sec": 5,
  "result_ttl_sec": 600,
  "max_inline_bytes": 65536
}
