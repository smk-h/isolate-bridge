{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "msgferry-bridge": {
      "type": "local",
      "command": ["node", "./index.mjs"],
      "enabled": true,
      "timeout": 600000,
      "environment": {
        "MSGFERRY_HGFS_ROOT": "/mnt/hgfs/sharedir/vm_share",
        "MSGFERRY_MAX_WAIT_MS": "30000",
        "MSGFERRY_POLLING_INITIAL": "500",
        "MSGFERRY_POLLING_MAX": "3000",
        "LOG_SAVE": "1"
      }
    },
    "msgferry-bridge-exchange": {
      "type": "local",
      "command": ["node", "./index.mjs"],
      "enabled": false,
      "timeout": 600000,
      "environment": {
        "MSGFERRY_HGFS_ROOT": "$HOME/.msgferry/vm_share",
        "MSGFERRY_MAX_WAIT_MS": "120000",
        "MSGFERRY_POLLING_INITIAL": "500",
        "MSGFERRY_POLLING_MAX": "3000",
        "MSGFERRY_SYNC_PUSH_CMD": "file_transfer -pd vm_share/{src} nfs/vm_share/{dst}",
        "MSGFERRY_SYNC_PULL_CMD": "file_transfer -g nfs/vm_share/inbound $HOME/.msgferry/vm_share/inbound",
        "MSGFERRY_SYNC_TIMEOUT_MS": "30000",
        "MSGFERRY_SYNC_RETRIES": "3",
        "LOG_SAVE": "1"
      }
    }
  }
}
