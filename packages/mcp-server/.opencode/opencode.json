{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "msgferry-bridge": {
      "type": "local",
      "command": ["node", "./index.mjs"],
      "enabled": true,
      "timeout": 600000,
      "environment": {
        "MSGFERRY_HGFS_ROOT": "/mnt/hgfs/sharedir/vm_share",
        "MSGFERRY_MAX_WAIT_MS": "30000",
        "MSGFERRY_POLLING_INITIAL": "500",
        "MSGFERRY_POLLING_MAX": "3000"
      }
    }
  }
}
