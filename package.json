{
  "name": "@smai-kit/msgferry",
  "version": "0.0.0",
  "private": true,
  "description": "MsgFerry - 隔离网络环境下基于 HGFS 文件队列的 AI 设备指令摆渡桥",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @smai-kit/msgferry-build run build:dist",
    "dev": "pnpm -r --parallel run dev",
    "clean": "pnpm -r exec rimraf dist && rimraf dist",
    "clean:all": "pnpm -r exec rimraf dist node_modules && rimraf dist node_modules",
    "clean-log": "node scripts/clean-log.mjs",
    "kill-node": "node scripts/kill-node.mjs",
    "kill-node:dry-run": "node scripts/kill-node.mjs --dry-run",
    "test:work:mock:shared": "node test/test_work.mjs",
    "test:work:mock:exchange": "node test/test_work.mjs --exchange",
    "test:work:ssh:shared": "node test/test_work.mjs --executor ssh2",
    "test:work:ssh:exchange": "node test/test_work.mjs --executor ssh2 --exchange",
    "test:client:shared": "node test/mcp-client.mjs",
    "test:client:exchange": "node test/mcp-client.mjs --exchange",
    "test:client:board-107": "node test/mcp-client.mjs --device board-107",
    "test:client:shared:verbose": "node test/mcp-client.mjs --verbose",
    "test:client:exchange:verbose": "node test/mcp-client.mjs --exchange --verbose",
    "git-sync-force": "node scripts/sync-force.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "rimraf": "^6.1.3"
  }
}
