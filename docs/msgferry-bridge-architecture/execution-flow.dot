  // row alignment
  { rank=same; CC_0; TOOL_0; Q_0; W_0; D_0; ph_0; }
  { rank=same; CC_1; TOOL_1; Q_1; W_1; D_1; }
  { rank=same; CC_2; TOOL_2; Q_2; W_2; D_2; }
  { rank=same; CC_3; TOOL_3; Q_3; W_3; D_3; }
  { rank=same; CC_4; TOOL_4; Q_4; W_4; D_4; ph_4; }
  { rank=same; CC_5; TOOL_5; Q_5; W_5; D_5; }
  { rank=same; CC_6; TOOL_6; Q_6; W_6; D_6; }
  { rank=same; CC_7; TOOL_7; Q_7; W_7; D_7; note_7; }
  { rank=same; CC_8; TOOL_8; Q_8; W_8; D_8; }
  { rank=same; CC_9; TOOL_9; Q_9; W_9; D_9; ph_9; }
  { rank=same; CC_10; TOOL_10; Q_10; W_10; D_10; note_10; }
  { rank=same; CC_11; TOOL_11; Q_11; W_11; D_11; }
  { rank=same; CC_12; TOOL_12; Q_12; W_12; D_12; }
  { rank=same; CC_13; TOOL_13; Q_13; W_13; D_13; }
  { rank=same; CC_14; TOOL_14; Q_14; W_14; D_14; note_14; }
  { rank=same; CC_15; TOOL_15; Q_15; W_15; D_15; }
  { rank=same; CC_16; TOOL_16; Q_16; W_16; D_16; ph_16; }
  { rank=same; CC_17; TOOL_17; Q_17; W_17; D_17; }
  { rank=same; CC_18; TOOL_18; Q_18; W_18; D_18; }
  { rank=same; CC_19; TOOL_19; Q_19; W_19; D_19; }
  { rank=same; CC_20; TOOL_20; Q_20; W_20; D_20; note_20; }
  { rank=same; CC_21; TOOL_21; Q_21; W_21; D_21; ph_21; }
  { rank=same; CC_22; TOOL_22; Q_22; W_22; D_22; }
  { rank=same; CC_23; TOOL_23; Q_23; W_23; D_23; }
  { rank=same; CC_24; TOOL_24; Q_24; W_24; D_24; note_24; }
  { rank=same; CC_25; TOOL_25; Q_25; W_25; D_25; ph_25; }
  { rank=same; CC_26; TOOL_26; Q_26; W_26; D_26; }
  { rank=same; CC_27; TOOL_27; Q_27; W_27; D_27; }
  { rank=same; CC_28; TOOL_28; Q_28; W_28; D_28; note_28; }

  // phase dividers
  edge [style=dashed, arrowhead=none, color="#B0B8C4", penwidth=1.4];
  CC_0 -> D_0 [constraint=false];
  CC_4 -> D_4 [constraint=false];
  CC_9 -> D_9 [constraint=false];
  CC_16 -> D_16 [constraint=false];
  CC_21 -> D_21 [constraint=false];
  CC_25 -> D_25 [constraint=false];
  // messages
  edge [style=solid, arrowhead=normal, penwidth=1.1];
  CC_1 -> TOOL_1 [color="#2B5797", style="solid", penwidth=1.1, constraint=false, xlabel="生成 Shell 指令"];
  TOOL_2 -> Q_2 [color="#2B5797", style="solid", penwidth=1.1, constraint=false, xlabel="检查 task_id 幂等"];
  TOOL_3 -> Q_3 [color="#2B5797", style="solid", penwidth=1.1, constraint=false, xlabel="写 .tmp → rename pending/<task_id>.json"];
  W_5 -> Q_5 [color="#E65100", style="solid", penwidth=1.1, constraint=false, xlabel="轮询 pending (500ms 退避)"];
  W_6 -> Q_6 [color="#E65100", style="solid", penwidth=1.1, constraint=false, xlabel="创建 processing/<task_id>.lock 抢占"];
  W_7 -> note_7 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  W_8 -> Q_8 [color="#E65100", style="solid", penwidth=1.1, constraint=false, xlabel="二次确认 processing 无同 id 文件"];
  W_10 -> note_10 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  W_11 -> D_11 [color="#6A1B9B", style="solid", penwidth=1.1, constraint=false, xlabel="校验通过：SSH 执行命令"];
  D_12 -> W_12 [color="#6A1B9B", style="dashed", penwidth=1.1, constraint=false, xlabel="stdout / stderr / exit_code"];
  W_13 -> Q_13 [color="#6A1B9B", style="solid", penwidth=1.1, constraint=false, xlabel="输出超 64KB：落盘 outputs/<task_id>.stdout"];
  W_14 -> note_14 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  W_15 -> Q_15 [color="#C62828", style="solid", penwidth=1.1, constraint=false, xlabel="校验失败：写 failed，error_msg=blocked_by_policy"];
  W_17 -> Q_17 [color="#2E7D32", style="solid", penwidth=1.1, constraint=false, xlabel="回写 completed / failed"];
  CC_18 -> TOOL_18 [color="#00838F", style="solid", penwidth=1.1, constraint=false, xlabel="轮询结果目录"];
  TOOL_19 -> CC_19 [color="#00838F", style="dashed", penwidth=1.1, constraint=false, xlabel="读取结果 JSON"];
  TOOL_20 -> note_20 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  TOOL_22 -> Q_22 [color="#C62828", style="solid", penwidth=1.1, constraint=false, xlabel="超时写 cancelled/<task_id>"];
  W_23 -> Q_23 [color="#C62828", style="solid", penwidth=1.1, constraint=false, xlabel="回写前检查 cancelled/"];
  W_24 -> note_24 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  W_26 -> Q_26 [color="#AAAAAA", style="solid", penwidth=1.1, constraint=false, xlabel="每 5s 写 heartbeat.json"];
  TOOL_27 -> Q_27 [color="#AAAAAA", style="solid", penwidth=1.1, constraint=false, xlabel="提交前读心跳"];
  TOOL_28 -> note_28 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
}