  { rank=same; AI_25; W_25; M_25; A_25; }
  { rank=same; AI_26; W_26; M_26; A_26; }
  { rank=same; AI_27; W_27; M_27; A_27; note_27; }
  { rank=same; AI_28; W_28; M_28; A_28; }
  { rank=same; AI_29; W_29; M_29; A_29; }
  { rank=same; AI_30; W_30; M_30; A_30; }
  { rank=same; AI_31; W_31; M_31; A_31; ph_31; }
  { rank=same; AI_32; W_32; M_32; A_32; note_32; }

  // phase dividers
  edge [style=dashed, arrowhead=none, color="#B0B8C4", penwidth=1.4];
  AI_0 -> A_0 [constraint=false];
  AI_8 -> A_8 [constraint=false];
  AI_14 -> A_14 [constraint=false];
  AI_23 -> A_23 [constraint=false];
  AI_31 -> A_31 [constraint=false];
  // messages
  edge [style=solid, arrowhead=normal, penwidth=1.1];
  AI_1 -> W_1 [color="#2B5797", style="solid", penwidth=1.1, constraint=false, xlabel="submit_ssh_task(cmd1, device=A)"];
  W_2 -> M_2 [color="#2B5797", style="solid", penwidth=1.1, constraint=false, xlabel="getOrCreateSession(\"A\") → sessions 未命中"];
  M_3 -> W_3 [color="#2B5797", style="dashed", penwidth=1.1, constraint=false, xlabel="查 map：无 \"A\" 的 Client → undefined"];
  W_4 -> A_4 [color="#2B5797", style="solid", penwidth=1.1, constraint=false, xlabel="new ssh2 Client() + 读私钥/密码 → TCP 三次握手"];
  A_5 -> W_5 [color="#2B5797", style="dashed", penwidth=1.1, constraint=false, xlabel="SSH 版本协商 → 密钥交换(KEX) → 认证签名 → ready"];
  W_6 -> M_6 [color="#2B5797", style="solid", penwidth=1.1, constraint=false, xlabel="缓存 Client → sessions.set(\"A\", client)"];
  W_7 -> note_7 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  W_9 -> A_9 [color="#2E7D32", style="solid", penwidth=1.1, constraint=false, xlabel="client.exec(cmd1) 在已握手连接上开 exec channel"];
  A_10 -> note_10 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  A_11 -> W_11 [color="#2E7D32", style="dashed", penwidth=1.1, constraint=false, xlabel="channel stdout/stderr/exit"];
  W_12 -> AI_12 [color="#2E7D32", style="dashed", penwidth=1.1, constraint=false, xlabel="返回 cmd1 结果（连接仍保留）"];
  W_13 -> note_13 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  AI_15 -> W_15 [color="#2E7D32", style="solid", penwidth=1.1, constraint=false, xlabel="submit_ssh_task(cmd2, device=A)"];
  W_16 -> M_16 [color="#2E7D32", style="solid", penwidth=1.1, constraint=false, xlabel="查 map：命中 \"A\" → 直接返回 Client"];
  M_17 -> W_17 [color="#2E7D32", style="dashed", penwidth=1.1, constraint=false, xlabel="ssh_1 Client（无握手）"];
  W_18 -> A_18 [color="#2E7D32", style="solid", penwidth=1.1, constraint=false, xlabel="client.exec(cmd2) 新 channel，新进程"];
  A_19 -> note_19 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  A_20 -> W_20 [color="#2E7D32", style="dashed", penwidth=1.1, constraint=false, xlabel="channel stdout/stderr/exit"];
  W_21 -> AI_21 [color="#2E7D32", style="dashed", penwidth=1.1, constraint=false, xlabel="返回 cmd2 结果"];
  W_22 -> note_22 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  AI_24 -> W_24 [color="#6A1B9B", style="solid", penwidth=1.1, constraint=false, xlabel="submit_ssh_task(cmd, device=B)"];
  W_25 -> M_25 [color="#6A1B9B", style="solid", penwidth=1.1, constraint=false, xlabel="查 map：无 \"B\" → 重新完整握手"];
  W_26 -> M_26 [color="#6A1B9B", style="solid", penwidth=1.1, constraint=false, xlabel="缓存 Client → sessions.set(\"B\", client)"];
  W_27 -> note_27 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
  W_28 -> A_28 [color="#6A1B9B", style="solid", penwidth=1.1, constraint=false, xlabel="client.exec(cmd) 在 B 的连接上执行"];
  A_29 -> W_29 [color="#6A1B9B", style="dashed", penwidth=1.1, constraint=false, xlabel="结果"];
  W_30 -> AI_30 [color="#6A1B9B", style="dashed", penwidth=1.1, constraint=false, xlabel="返回结果（A/B 连接互不干扰、各自复用）"];
  W_32 -> note_32 [style=dashed, dir=none, color="#B9A00B", arrowhead=none, penwidth=1];
}