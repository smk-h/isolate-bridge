@startuml 方案A整体架构
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Segoe UI"
skinparam ArrowColor #5A5A5A
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 11
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #7A93BE
  BorderThickness 1
  FontColor #1F2933
  FontSize 12
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #E0B400
  FontColor #5C4A00
  FontSize 10
}

title 方案 A：当前项目方案（MsgFerry 基线）—— 文件消息队列 + 内网 LLM + 外网无模型 Worker

rectangle "内网 VMware 虚拟桌面（TCP 完全隔离，无外网）" as intranet #DDF3E4 {
  rectangle "Claude Code\n唯一智能体\n规划 / 分析 / 决策" as cc #DCE9FB
  rectangle "MCP Server\n(TypeScript)\n随会话生死的子进程\nsubmit / query / cancel / health" as mcp #B4C9E8
  rectangle "内网提交日志\ntask_id / 时间 / 结果" as inlog #FFFFFF
}

rectangle "VMware HGFS 共享文件夹\n唯一跨域通信介质（不走网卡协议栈）" as hgfs #FFE8E8 {
  rectangle "pending/\n待执行任务" as pending #FFFFFF
  rectangle "processing/\n+ .lock 抢占" as proc #FFFFFF
  rectangle "completed/\n成功结果" as done #FFFFFF
  rectangle "failed/\n失败/超时/拦截" as fail #FFFFFF
  rectangle "cancelled/\n取消+孤儿回收" as canc #FFFFFF
  rectangle "outputs/\n大输出分包" as outs #FFFFFF
  rectangle "heartbeat.json\nWorker 心跳" as hb #FFFFFF
  rectangle "policy/\n命令策略(外网维护)" as pol #FFFFFF
}

rectangle "外网 Windows 宿主机（公网可达）" as host #DDF3E4 {
  rectangle "Node.js Worker\n(TypeScript)\n常驻后台 / 纯 IO 执行\n无大模型 / 无推理" as worker #B4C9E8
  rectangle "安全策略\n白/黑名单 + 参数校验" as w2 #FFFFFF
  rectangle "SSH 执行器\n超时控制 / 大输出分流" as w3 #FFFFFF
  rectangle "审计日志\n滚动 / 30 天" as outlog #FFFFFF
}

rectangle "外部设备 A\n仅外网 SSH 接入" as deviceA #FFF3D6

rectangle "shared/\n任务结构体类型\n错误码枚举\n路径常量" as shared #F0E8FA

mcp -[#2B5797,thickness=2]-> pending : <color:#2B5797>① 写任务\n(.tmp → rename)</color>
worker -[#E65100,thickness=2]-> pending : <color:#E65100>② 轮询 pending\n(500ms 退避)</color>
worker -[#2E7D32,thickness=2]-> proc : <color:#2E7D32>③ 创建 .lock 抢占</color>
w3 -[#6A1B9B,thickness=2]-> deviceA : <color:#6A1B9B>④ SSH 执行</color>
worker -[#C62828,thickness=2]-> done : <color:#C62828>⑤ 回写结果\n(completed/failed)</color>
mcp -[#00838F,thickness=2]-> done : <color:#00838F>⑥ 轮询结果\n(500ms 退避)</color>

cc -[#CCCCCC,thickness=1]-> mcp : <color:#999999>MCP 工具调用(stdio)</color>
worker -[#CCCCCC,thickness=1]-> w2 : <color:#999999>校验</color>
worker -[#CCCCCC,thickness=1]-> w3 : <color:#999999>执行</color>
worker -[#CCCCCC,thickness=1]-> outlog : <color:#999999>记录</color>

worker -[#AAAAAA]-> hb : <color:#888888>5s 写心跳</color>
mcp -[#AAAAAA]-> hb : <color:#888888>提交前读心跳</color>
worker -[#AAAAAA]-> canc : <color:#888888>检查取消标记</color>
worker -[#AAAAAA]-> outs : <color:#888888>落大输出</color>

shared -[#7B1FA2,dashed]-> mcp : <color:#7B1FA2>引用类型</color>
shared -[#7B1FA2,dashed]-> worker : <color:#7B1FA2>引用类型</color>

note right of intranet
  进程①由 Claude Code 通过 MCP 配置拉起(stdio)
  提交后同步阻塞轮询 completed/failed/cancelled
  超时(30s)则写 cancelled/<task_id> 取消标记
end note

note right of host
  进程②常驻后台，开机自启
  now - last_beat > 15s 时
  内网提交前读心跳返回 worker_offline
end note

note right of shared
  内外网虽在不同网络域
  但共享同一份类型定义
  保证任务 JSON 读写契约一致
end note

legend right
  |= 颜色 |= 含义 |
  | <color:#2B5797>■</color> 蓝 | ① 写任务（MCP → pending） |
  | <color:#E65100>■</color> 橙 | ② 轮询 pending（Worker 消费） |
  | <color:#2E7D32>■</color> 绿 | ③ 创建 .lock 抢占 |
  | <color:#6A1B9B>■</color> 紫 | ④ SSH 执行设备 A |
  | <color:#C62828>■</color> 红 | ⑤ 回写结果（Worker → completed/failed） |
  | <color:#00838F>■</color> 青 | ⑥ 轮询结果（MCP 读取返回） |
  | <color:#AAAAAA>■</color> 灰 | 辅助操作（心跳/取消/大输出） |
  | <color:#7B1FA2>┄</color> 紫虚 | shared 类型契约引用 |
  | <color:#CCCCCC>■</color> 浅灰 | 进程内部调用 |
endlegend

@enduml
